# AI Pulse Backend Configuration
SECRET_KEY=change-this-in-production-use-a-strong-secret
DATABASE_URL=sqlite:///./aipulse.db
AI_MODE=mock  # Options: "mock" (offline canned responses) or "live" (OpenAI-compatible completions)

# Required only if AI_MODE=live:
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# CORS allowed origins (comma-separated):
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
